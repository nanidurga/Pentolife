# Get both values from Supabase: Project Settings -> API.
# This is a browser-safe publishable key. Never put a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Random string; Vercel Cron sends it as "Authorization: Bearer <value>" to /api/cron/keepalive.
CRON_SECRET=
